# Rendered by the nginx image at start-up (${API_*} come from the environment).
# Two setups share this template:
#   docker-compose: API_UPSTREAM=backend:8000, API_UPSTREAM_SCHEME=http, API_RESOLVER_LINE empty
#                   -> nginx resolves "backend" once at start-up (Docker's internal DNS).
#   Render:         API_UPSTREAM=<api-host>.onrender.com, API_UPSTREAM_SCHEME=https, and a resolver
#                   line -> the free API service changes IPs on restart/redeploy, so nginx must ask
#                   DNS again per request, and Render routes by the Host header, so it must carry the
#                   API's host, not the web app's.
# Keep the browser on one domain (the web app's): the httpOnly SameSite=Lax login cookie just works.
map $http_x_forwarded_proto $forwarded_proto {
    # Render's edge proxy terminates HTTPS and tells us the original scheme; keep it for the API so
    # uvicorn's --proxy-headers sees https. Without the header (plain HTTP in front) fall back to ours.
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 15m;  # resume uploads (MAX_UPLOAD_MB=5) and voice clips (~12 MB max)

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # camera/microphone are used by the interview pages of this site only
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm model/gltf-binary;

    # API: same origin for the browser, so the httpOnly SameSite=Lax login cookie just works
    location /api/ {
${API_RESOLVER_LINE}
        set $api_upstream "${API_UPSTREAM_SCHEME}://${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;  # https upstreams need SNI (onrender.com serves many names)
        proxy_http_version 1.1;
        proxy_set_header Host ${API_UPSTREAM};  # Render routes by Host: must be the API's own host
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        # streamed interviewer replies (Server-Sent Events) must not be buffered
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Vite's hashed bundles never change: cache for a year
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # large static models (3D avatars, face detection) - cache a week
    location ~* ^/(avatars|mediapipe|models)/ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # single-page app: every other path is a client-side route
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
