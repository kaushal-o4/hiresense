# ---- HireSense: hosted demo / cloud profile ----
# For a small server WITHOUT a GPU, Ollama or PyTorch (Render, Railway, a 1 GB VM, Docker).
# Install with: pip install -r requirements-cloud.txt     (docs/DEPLOY.md has the step-by-step guide)
# On Render/Vercel these are set as environment variables in the dashboard instead of a file.

ENVIRONMENT=production
# MongoDB Atlas connection string (Database -> Connect -> Drivers). Include the user and password.
MONGODB_URL=mongodb+srv://hiresense:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hiresense

# 64+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
COOKIE_SECURE=true
# lax  = the browser reaches the API through the frontend's own domain (Vercel /api rewrite) - recommended
# none = the browser calls the API's own domain directly (VITE_API_URL set in the frontend build)
COOKIE_SAMESITE=lax
# The frontend's address(es). Needed for COOKIE_SAMESITE=none; harmless otherwise.
CORS_ORIGINS=https://<your-app>.vercel.app
FRONTEND_URL=https://<your-app>.vercel.app

# First admin account, created by `python -m app.seed` (Render runs it before each start; it is safe to repeat).
ADMIN_EMAIL=admin@hiresense.app
# Set a strong one. Empty = a random password is printed once in the deploy log.
ADMIN_PASSWORD=

# ---- AI: Google Gemini (resumes, answers and voice recordings are SENT TO GOOGLE; students are asked to agree) ----
AI_ENABLED=true
LOCAL_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BACKUP_MODELS=gemini-3.5-flash-lite
GEMINI_THINKING=minimal
# No local model to fall back to on this host
AI_FALLBACK_TO_OLLAMA=false
GEMINI_COOLDOWN_SECONDS=0
# Protects your Gemini quota on a public demo
AI_DAILY_LIMIT_PER_USER=60
AI_MAX_CONCURRENT=4

# ---- Things the cloud host does not run ----
# Job matching uses skills and keywords instead of the local sentence-embedding model
EMBEDDING_PROVIDER=none
# Interviewer voice: the browser's built-in voice (Kokoro needs PyTorch)
TTS_ENABLED=false
# Speech recognition: answers are transcribed by Gemini (no live captions). STT_ENABLED=false = typed answers only.
STT_ENABLED=true
STT_ENGINE=gemini

# ---- Optional ----
# Shared login lockout / rate limits across several API instances (e.g. a free Upstash or Render Key Value URL)
REDIS_URL=
SHUTDOWN_GRACE_SECONDS=20
MAX_UPLOAD_MB=5
# Uploaded resumes are stored here. On Render's free plan the disk is wiped on every deploy/restart: resume FILES
# then disappear (the extracted text and analysis stay in MongoDB). Attach a disk or accept this for a demo.
UPLOAD_DIR=/tmp/hiresense-uploads

# Email (password-reset links). Empty SMTP_HOST = links are printed in the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HireSense <no-reply@example.com>
