# ---- HireSense backend configuration ----
# Database: MongoDB (install MongoDB Community Server; on Windows it runs as the "MongoDB" service).
# For MongoDB Atlas use the mongodb+srv://user:password@cluster/... connection string instead.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=hiresense

# Long random string used to sign login tokens. CHANGE THIS in production.
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=720
# Set to true when serving over HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First admin account (created by: python -m app.seed). Leave ADMIN_PASSWORD empty and the seed generates a
# random password and prints it ONCE in the console - store it safely. Change it later in Account settings.
ADMIN_EMAIL=admin@hiresense.app
ADMIN_PASSWORD=

# ---- Email (optional) ----
# Used for password-reset links and application updates. Leave SMTP_HOST empty to turn email off: reset links
# are then printed in the backend console so the placement office can pass them on.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HireSense <no-reply@hiresense.local>
SMTP_STARTTLS=true
# Address of the web app, used to build links in emails
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30

# ---- AI provider ----
# gemini = Google Gemini API: fast and reliable, but prompts (resumes, interview answers) are SENT TO GOOGLE.
#          Get a key at https://aistudio.google.com/apikey . No key / no internet -> local Ollama is used (fallback).
# ollama = fully local (nothing leaves this computer), slower on a laptop GPU.
LOCAL_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Google's alias for the newest Flash model; if this key can't use it, the newest available Flash model is picked.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
# minimal | low | medium | high | off  (less thinking = faster replies)
GEMINI_THINKING=minimal
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_CONCURRENT=8
GEMINI_RETRIES=2
AI_FALLBACK_TO_OLLAMA=true
GEMINI_COOLDOWN_SECONDS=120

# ---- Local AI / fallback (no API key needed; nothing leaves this computer) ----
# Install Ollama from https://ollama.com, then:  ollama pull qwen3:4b
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b (Apache-2.0) needs ~3.5 GB free RAM/VRAM. On an 8 GB laptop use qwen3:1.7b instead.
OLLAMA_MODEL=qwen3:4b
# Optional per-task models. Empty = OLLAMA_MODEL for everything. On the 4 GB test GPU, qwen3:1.7b for English chat cut a
# turn from ~22 s to ~2 s, but it scores answers far too generously, so do NOT use it for OLLAMA_MODEL_STRONG/default.
# Only one model fits on the GPU: each switch costs a 5-8 s load (the app unloads the old one first).
# Run `ollama pull <model>` for each. See docs/PERFORMANCE_BASELINE.md.
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_STRONG=
OLLAMA_NUM_CTX=4096
# Layers on the GPU (99 = all, -1 = Ollama decides)
OLLAMA_NUM_GPU=99
OLLAMA_KEEP_ALIVE=30m
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=240
AI_MAX_CONCURRENT=1
AI_DAILY_LIMIT_PER_USER=200
MAX_RESUME_CHARS=12000

# Semantic job matching (downloaded once from Hugging Face, ~90 MB, Apache-2.0). Set to none to disable.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Job-match weights (see app/services/matching.py)
MATCH_WEIGHT_REQUIRED=0.50
MATCH_WEIGHT_PREFERRED=0.15
MATCH_WEIGHT_SEMANTIC=0.20
MATCH_WEIGHT_EXPERIENCE=0.15

# Voice interview (local). Kokoro-82M voice ~330 MB + Whisper base.en ~150 MB, downloaded once.
TTS_ENABLED=true
# af_heart, af_bella, af_nicole, bf_emma, am_michael, bm_george
TTS_VOICE=af_heart
TTS_SPEED=1.0
STT_ENABLED=true
# faster = faster-whisper (fast, default) or transformers; models: base.en (fast) / small.en (more accurate)
STT_ENGINE=faster
STT_MODEL=base.en
VOICE_MAX_ANSWER_SECONDS=180

MAX_UPLOAD_MB=5
