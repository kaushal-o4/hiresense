# ---- HireSense backend configuration ----
# Database: SQLite by default (no install needed). For PostgreSQL:
#   pip install -r requirements-postgres.txt
#   DATABASE_URL=postgresql+psycopg://hiresense:password@localhost:5432/hiresense
DATABASE_URL=sqlite:///./hiresense.db

# Long random string used to sign login tokens. CHANGE THIS in production.
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=720
# Set to true when serving over HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First admin account (created by: python -m app.seed)
ADMIN_EMAIL=admin@hiresense.app
ADMIN_PASSWORD=Admin@12345

# ---- Local AI (no API key needed; nothing leaves this computer) ----
# Install Ollama from https://ollama.com, then:  ollama pull qwen3:4b
AI_ENABLED=true
LOCAL_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b (Apache-2.0) needs ~3.5 GB free RAM/VRAM. On an 8 GB laptop use qwen3:1.7b instead.
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=240
AI_MAX_CONCURRENT=1
AI_DAILY_LIMIT_PER_USER=200
MAX_RESUME_CHARS=12000

# Semantic job matching (downloaded once from Hugging Face, ~90 MB, Apache-2.0). Set to none to disable.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Job-match weights (see app/services/matching.py)
MATCH_WEIGHT_REQUIRED=0.50
MATCH_WEIGHT_PREFERRED=0.15
MATCH_WEIGHT_SEMANTIC=0.20
MATCH_WEIGHT_EXPERIENCE=0.15

# Voice interview (local). Kokoro-82M voice ~330 MB + Whisper base.en ~150 MB, downloaded once.
TTS_ENABLED=true
# af_heart, af_bella, af_nicole, bf_emma, am_michael, bm_george
TTS_VOICE=af_heart
TTS_SPEED=1.0
STT_ENABLED=true
STT_MODEL=openai/whisper-base.en
VOICE_MAX_ANSWER_SECONDS=180

MAX_UPLOAD_MB=5
