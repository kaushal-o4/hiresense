# Settings for docker-compose.yml. Copy to .env.docker (git-ignored) and fill in:
#   docker compose --env-file .env.docker up -d --build
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

MONGO_USER=hiresense
MONGO_PASSWORD=
SECRET_KEY=

# Google Gemini key (https://aistudio.google.com/apikey). Resumes, answers and voice recordings are sent to Google;
# students are asked to agree first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BACKUP_MODELS=gemini-3.5-flash-lite
AI_DAILY_LIMIT_PER_USER=60

# First admin account. Empty password = a random one is printed once: docker compose logs backend
ADMIN_EMAIL=admin@hiresense.app
ADMIN_PASSWORD=

# Address people open in the browser. Behind an HTTPS reverse proxy: https://your-domain and COOKIE_SECURE=true
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
WEB_PORT=8080

# Optional
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HireSense <no-reply@example.com>
